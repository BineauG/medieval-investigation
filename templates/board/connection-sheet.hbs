<div class="mit-form-content">
<div class="mit-form-body">
  <fieldset class="mit-string-palette">
    <legend>{{localize "medieval-investigation-toolkit.ConnectionEditor.Color"}}</legend>
    {{#each colors}}
    <label class="mit-string-color-choice" title="{{label}}">
      <input type="radio" name="color" value="{{value}}" {{checked selected}}>
      <span class="mit-string-color-swatch" style="--mit-string-color: {{value}}"></span>
      <span>{{label}}</span>
    </label>
    {{/each}}
  </fieldset>
  <div class="form-group"><label for="mit-connection-width">{{localize "medieval-investigation-toolkit.ConnectionEditor.Width"}}</label><input id="mit-connection-width" type="number" name="width" min="1" max="20" value="{{connection.style.width}}"></div>
  <div class="form-group"><label for="mit-connection-sag">{{localize "medieval-investigation-toolkit.ConnectionEditor.Sag"}}</label><input id="mit-connection-sag" type="range" name="sag" min="0" max="0.5" step="0.01" value="{{connection.style.sag}}"></div>
</div>
<footer class="form-footer"><button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize "medieval-investigation-toolkit.Actions.Save"}}</button></footer>
</div>

<div class="mit-form-content">
<div class="mit-form-body">
  <div class="form-group stacked">
    <label for="mit-note-text">{{localize "medieval-investigation-toolkit.CardEditor.TitleOverride"}}</label>
    <input id="mit-note-text" type="text" name="noteText" value="{{noteText}}" maxlength="40" required autocomplete="off">
    <p class="hint">{{localize "medieval-investigation-toolkit.NoteEditor.Hint"}}</p>
  </div>
</div>
<footer class="form-footer">
  <button type="submit"><i class="fa-solid fa-check"></i> {{localize "medieval-investigation-toolkit.Actions.Save"}}</button>
</footer>
</div>

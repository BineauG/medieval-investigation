<div class="mit-form-content">
  <div class="mit-form-body">
    <div class="form-group">
      <label for="mit-faction-name">{{localize "medieval-investigation-toolkit.FactionEditor.Name"}}</label>
      <input id="mit-faction-name" name="name" type="text" value="{{faction.name}}" required autofocus autocomplete="off">
    </div>
    <div class="form-group">
      <label for="mit-faction-shape">{{localize "medieval-investigation-toolkit.FactionEditor.Shape"}}</label>
      <select id="mit-faction-shape" name="shape">
        <option value="rounded-rectangle" {{#if rounded}}selected{{/if}}>{{localize "medieval-investigation-toolkit.Shapes.RoundedRectangle"}}</option>
        <option value="ellipse" {{#if ellipse}}selected{{/if}}>{{localize "medieval-investigation-toolkit.Shapes.Ellipse"}}</option>
        <option value="polygon" {{#if polygon}}selected{{/if}}>{{localize "medieval-investigation-toolkit.Shapes.Polygon"}}</option>
      </select>
    </div>
    <div class="form-group">
      <label for="mit-faction-fill">{{localize "medieval-investigation-toolkit.FactionEditor.Fill"}}</label>
      <input id="mit-faction-fill" name="fill" type="color" value="{{faction.style.fill}}">
    </div>
    <div class="form-group">
      <label for="mit-faction-stroke">{{localize "medieval-investigation-toolkit.FactionEditor.Stroke"}}</label>
      <input id="mit-faction-stroke" name="stroke" type="color" value="{{faction.style.stroke}}">
    </div>
    <div class="form-group">
      <label for="mit-faction-opacity">{{localize "medieval-investigation-toolkit.FactionEditor.Opacity"}}</label>
      <input id="mit-faction-opacity" name="fillOpacity" type="number" min="0" max="1" step="0.05" value="{{faction.style.fillOpacity}}">
    </div>
  </div>
  <footer class="form-footer"><button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize "medieval-investigation-toolkit.Actions.Save"}}</button></footer>
</div>

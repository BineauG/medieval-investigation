<div class="mit-form-content">
<div class="mit-form-body">
  <div class="form-group"><label for="mit-faction-name">{{localize "medieval-investigation-toolkit.FactionEditor.Name"}}</label><input id="mit-faction-name" name="name" type="text" value="{{faction.name}}" required autofocus></div>
  <div class="form-group stacked"><label for="mit-faction-description">{{localize "medieval-investigation-toolkit.FactionEditor.Description"}}</label><textarea id="mit-faction-description" name="description" rows="4">{{faction.description}}</textarea></div>
  <div class="form-group"><label for="mit-faction-shape">{{localize "medieval-investigation-toolkit.FactionEditor.Shape"}}</label><select id="mit-faction-shape" name="shape"><option value="rounded-rectangle" {{#if rounded}}selected{{/if}}>{{localize "medieval-investigation-toolkit.Shapes.RoundedRectangle"}}</option><option value="ellipse" {{#if ellipse}}selected{{/if}}>{{localize "medieval-investigation-toolkit.Shapes.Ellipse"}}</option><option value="polygon" {{#if polygon}}selected{{/if}}>{{localize "medieval-investigation-toolkit.Shapes.Polygon"}}</option></select></div>
  <div class="form-group"><label for="mit-faction-width">{{localize "medieval-investigation-toolkit.FactionEditor.Width"}}</label><input id="mit-faction-width" name="width" type="number" min="100" value="{{faction.width}}"><label for="mit-faction-height">{{localize "medieval-investigation-toolkit.FactionEditor.Height"}}</label><input id="mit-faction-height" name="height" type="number" min="80" value="{{faction.height}}"></div>
  <div class="form-group"><label for="mit-faction-fill">{{localize "medieval-investigation-toolkit.FactionEditor.Fill"}}</label><input id="mit-faction-fill" name="fill" type="color" value="{{faction.style.fill}}"><label for="mit-faction-opacity">{{localize "medieval-investigation-toolkit.FactionEditor.Opacity"}}</label><input id="mit-faction-opacity" name="fillOpacity" type="number" min="0" max="1" step="0.05" value="{{faction.style.fillOpacity}}"></div>
  <div class="form-group"><label for="mit-faction-stroke">{{localize "medieval-investigation-toolkit.FactionEditor.Stroke"}}</label><input id="mit-faction-stroke" name="stroke" type="color" value="{{faction.style.stroke}}"><label for="mit-faction-stroke-width">{{localize "medieval-investigation-toolkit.FactionEditor.StrokeWidth"}}</label><input id="mit-faction-stroke-width" name="strokeWidth" type="number" min="1" max="20" value="{{faction.style.strokeWidth}}"></div>
  {{#if members.length}}<fieldset class="mit-member-list"><legend>{{localize "medieval-investigation-toolkit.FactionEditor.Members"}}</legend>{{#each members}}<label><input type="checkbox" name="memberNodeIds" value="{{id}}" {{checked checked}}> {{name}}</label>{{/each}}</fieldset>{{/if}}
</div>
<footer class="form-footer"><button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize "medieval-investigation-toolkit.Actions.Save"}}</button></footer>
</div>

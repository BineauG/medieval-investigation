<div class="mit-form-content">
<div class="mit-form-body">
  <div class="form-group"><label for="mit-custom-node-name">{{localize "medieval-investigation-toolkit.CustomNodeEditor.Name"}}</label><input id="mit-custom-node-name" name="name" type="text" maxlength="500" value="{{node.name}}" required autofocus></div>
  <div class="form-group"><label for="mit-custom-node-image">{{localize "medieval-investigation-toolkit.CustomNodeEditor.Image"}}</label><div class="form-fields"><input id="mit-custom-node-image" name="image" type="text" maxlength="2000" value="{{node.image}}" required><button type="button" data-image-picker title="{{localize 'medieval-investigation-toolkit.CustomNodeEditor.Browse'}}"><i class="fa-solid fa-folder-open"></i></button></div></div>
  <div class="mit-card-editor-preview-wrap"><img class="mit-card-editor-preview" data-node-image-preview src="{{node.image}}" alt="" {{#unless node.image}}hidden{{/unless}}></div>
</div>
<footer class="form-footer"><button type="submit"><i class="fa-solid fa-plus"></i> {{localize "medieval-investigation-toolkit.CustomNodeEditor.Create"}}</button></footer>
</div>
